APP_NAME=Ingredio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production safety: set APP_DEBUG=false and TRUSTED_PROXIES to the actual
# reverse-proxy CIDRs (e.g. Coolify/Traefik) instead of leaving it as *.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production uses MySQL/MariaDB — set DB_CONNECTION=mysql and fill these in.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production safety: set SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true
# when running over HTTPS behind a trusted proxy.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production uses QUEUE_CONNECTION=redis (a Redis service is provisioned there).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (pure PHP, no extension required) rather than phpredis, so it works
# in any container without needing the redis PHP extension compiled in.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=180

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Recipe scanning / AI extraction
GEMINI_API_KEY=
GEMINI_MAX_OUTPUT_TOKENS=2048
SCAN_DRIVER=gemini
SCAN_MODEL=gemini-flash-latest
SCAN_KEEP_SOURCE=false
SCAN_DISK=local
SCAN_MAX_UPLOAD_KB=20480
SCAN_URL_TIMEOUT=15
SCAN_URL_CONNECT_TIMEOUT=5
SCAN_URL_MAX_BYTES=3000000
SCAN_URL_MAX_REDIRECTS=3
SCAN_URL_USER_AGENT="IngredioBot/1.0 (+recipe import)"
SCAN_RATE_LIMIT_PER_MINUTE=5
SCAN_RATE_LIMIT_PER_DAY=20

# Error tracking (production) — leave blank locally; the SDK no-ops without a DSN.
SENTRY_LARAVEL_DSN=
